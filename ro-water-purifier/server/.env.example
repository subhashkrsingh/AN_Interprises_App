NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ro_water
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ro_water
DB_USER=postgres
DB_PASSWORD=postgres

REDIS_URL=redis://localhost:6379
SOCKET_ORIGIN=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-token-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_SECURE=false
UPLOAD_DIR=uploads

GOOGLE_CLIENT_ID=replace_with_your_google_client_id

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RO Water Admin <no-reply@example.com>"

SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
