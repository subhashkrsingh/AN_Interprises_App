generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String               @id @default(cuid())
  name                   String
  email                  String               @unique
  phone                  String?
  passwordHash           String
  status                 UserStatus           @default(ACTIVE)
  avatarUrl              String?
  twoFactorEnabled       Boolean              @default(false)
  twoFactorSecret        String?
  twoFactorBackupCodes   Json?
  lastLoginAt            DateTime?
  refreshTokenHash       String?
  refreshTokenExpires    DateTime?
  passwordResetTokenHash String?
  passwordResetExpires   DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  activityLogs           ActivityLog[]
  customerNotes          CustomerNote[]
  engineerProfile        Engineer?
  leadFollowups          LeadFollowup[]
  assignedLeads          Lead[]               @relation("LeadAssignee")
  loginHistory           LoginHistory[]
  notifications          Notification[]
  twoFactorChallenges    TwoFactorChallenge[]
  roles                  UserRole[]
  sessions               UserSession[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String?
  deviceName       String?
  deviceType       String?
  ipAddress        String?
  userAgent        String?
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model LoginHistory {
  id         String      @id @default(cuid())
  userId     String?
  email      String
  result     LoginResult
  reason     String?
  ipAddress  String?
  userAgent  String?
  deviceName String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_history")
}

model TwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

model Customer {
  id               String          @id @default(cuid())
  customerName     String
  mobileNumber     String          @unique
  whatsappNumber   String?
  email            String?
  address          String
  city             String
  state            String
  pincode          String
  waterTdsLevel    Int?
  installationDate DateTime?
  customerNotes    String?
  status           UserStatus      @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  amcContracts     CustomerAmc[]
  notes            CustomerNote[]
  invoices         Invoice[]
  leads            Lead[]
  orders           Order[]
  payments         Payment[]
  quotations       Quotation[]
  serviceTickets   ServiceTicket[]
  serviceVisits    ServiceVisit[]

  @@index([customerName])
  @@index([mobileNumber])
  @@index([city])
  @@index([deletedAt])
  @@map("customers")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  userId     String?
  note       String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@map("customer_notes")
}

model Lead {
  id                String         @id @default(cuid())
  leadNumber        String         @unique
  customerId        String?
  assignedToId      String?
  interestProductId String?
  source            LeadSource
  status            LeadStatus     @default(NEW)
  name              String
  mobile            String
  whatsappNumber    String?
  email             String?
  city              String?
  budget            Decimal?       @db.Decimal(12, 2)
  notes             String?
  nextFollowUpAt    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  followups         LeadFollowup[]
  assignedTo        User?          @relation("LeadAssignee", fields: [assignedToId], references: [id])
  customer          Customer?      @relation(fields: [customerId], references: [id])
  interestProduct   Product?       @relation(fields: [interestProductId], references: [id])
  orders            Order[]
  quotations        Quotation[]

  @@index([status])
  @@index([source])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("leads")
}

model LeadFollowup {
  id          String    @id @default(cuid())
  leadId      String
  userId      String?
  scheduledAt DateTime
  completedAt DateTime?
  channel     String
  outcome     String?
  notes       String?
  createdAt   DateTime  @default(now())
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([scheduledAt])
  @@map("lead_followups")
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?
  imageUrl        String?
  bannerUrl       String?
  metaTitle       String?
  metaDescription String?
  sortOrder       Int        @default(0)
  status          Boolean    @default(true)
  parentId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  products        Product[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Brand {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  logoUrl         String?
  description     String?
  metaTitle       String?
  metaDescription String?
  status          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  products        Product[]

  @@index([status])
  @@map("brands")
}

model Product {
  id              String          @id @default(cuid())
  productType     ProductType
  name            String
  brandId         String?
  categoryId      String
  modelNumber     String?
  sku             String          @unique
  slug            String          @unique
  mrp             Decimal         @db.Decimal(12, 2)
  salePrice       Decimal         @db.Decimal(12, 2)
  costPrice       Decimal?        @db.Decimal(12, 2)
  stockQuantity   Int             @default(0)
  warrantyMonths  Int?
  description     String?
  features        Json?
  specifications  Json?
  status          ProductStatus   @default(ACTIVE)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  amcContracts    CustomerAmc[]
  inventory       Inventory?
  leadInterests   Lead[]
  orderItems      OrderItem[]
  images          ProductImage[]
  brand           Brand?          @relation(fields: [brandId], references: [id])
  category        Category        @relation(fields: [categoryId], references: [id])
  serviceTickets  ServiceTicket[]
  serviceVisits   ServiceVisit[]

  @@index([name])
  @@index([productType])
  @@index([status])
  @@index([categoryId])
  @@index([brandId])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Supplier {
  id            String      @id @default(cuid())
  supplierName  String
  contactPerson String?
  mobile        String?
  email         String?
  gstNumber     String?
  address       String?
  city          String?
  state         String?
  status        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  inventory     Inventory[]

  @@index([supplierName])
  @@map("suppliers")
}

model Inventory {
  id                String      @id @default(cuid())
  productId         String      @unique
  supplierId        String?
  stockQuantity     Int         @default(0)
  reservedQuantity  Int         @default(0)
  lowStockThreshold Int         @default(5)
  location          String?
  stockStatus       StockStatus @default(IN_STOCK)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier          Supplier?   @relation(fields: [supplierId], references: [id])

  @@index([stockStatus])
  @@index([supplierId])
  @@map("inventory")
}

model Engineer {
  id              String               @id @default(cuid())
  userId          String?              @unique
  name            String
  mobile          String               @unique
  email           String?
  skills          Json?
  active          Boolean              @default(true)
  rating          Decimal              @default(0) @db.Decimal(3, 2)
  currentLocation Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  amcContracts    CustomerAmc[]
  attendance      EngineerAttendance[]
  user            User?                @relation(fields: [userId], references: [id])
  serviceTickets  ServiceTicket[]
  serviceVisits   ServiceVisit[]

  @@index([active])
  @@map("engineers")
}

model EngineerAttendance {
  id             String           @id @default(cuid())
  engineerId     String
  attendanceDate DateTime
  status         AttendanceStatus @default(PRESENT)
  checkInAt      DateTime?
  checkOutAt     DateTime?
  latitude       Decimal?         @db.Decimal(10, 7)
  longitude      Decimal?         @db.Decimal(10, 7)
  notes          String?
  createdAt      DateTime         @default(now())
  engineer       Engineer         @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([attendanceDate])
  @@map("engineer_attendance")
}

model ServiceTicket {
  id             String              @id @default(cuid())
  ticketNumber   String              @unique
  customerId     String
  productId      String?
  engineerId     String?
  type           ServiceTicketType
  status         ServiceTicketStatus @default(OPEN)
  visitDate      DateTime?
  issue          String
  resolution     String?
  partsUsed      Json?
  serviceCharges Decimal             @default(0) @db.Decimal(12, 2)
  priority       String              @default("Normal")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  customer       Customer            @relation(fields: [customerId], references: [id])
  engineer       Engineer?           @relation(fields: [engineerId], references: [id])
  product        Product?            @relation(fields: [productId], references: [id])
  visits         ServiceVisit[]

  @@index([status])
  @@index([type])
  @@index([customerId])
  @@index([engineerId])
  @@index([visitDate])
  @@index([deletedAt])
  @@map("service_tickets")
}

model ServiceVisit {
  id               String              @id @default(cuid())
  serviceTicketId  String
  customerId       String
  productId        String?
  engineerId       String
  visitDate        DateTime
  status           ServiceTicketStatus @default(ASSIGNED)
  issue            String?
  resolution       String?
  partsUsed        Json?
  serviceCharges   Decimal             @default(0) @db.Decimal(12, 2)
  customerRating   Int?
  customerFeedback String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  customer         Customer            @relation(fields: [customerId], references: [id])
  engineer         Engineer            @relation(fields: [engineerId], references: [id])
  product          Product?            @relation(fields: [productId], references: [id])
  serviceTicket    ServiceTicket       @relation(fields: [serviceTicketId], references: [id], onDelete: Cascade)

  @@index([serviceTicketId])
  @@index([engineerId])
  @@index([visitDate])
  @@map("service_visits")
}

model AmcPlan {
  id             String        @id @default(cuid())
  name           String
  tier           AmcPlanTier
  durationMonths Int
  includedVisits Int
  includedParts  Json?
  price          Decimal       @db.Decimal(12, 2)
  description    String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customerAmc    CustomerAmc[]

  @@index([tier])
  @@index([active])
  @@map("amc_plans")
}

model CustomerAmc {
  id              String    @id @default(cuid())
  customerId      String
  productId       String?
  planId          String
  engineerId      String?
  startDate       DateTime
  endDate         DateTime
  includedVisits  Int
  usedVisits      Int       @default(0)
  includedParts   Json?
  price           Decimal   @db.Decimal(12, 2)
  status          AmcStatus @default(ACTIVE)
  nextServiceDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  engineer        Engineer? @relation(fields: [engineerId], references: [id])
  plan            AmcPlan   @relation(fields: [planId], references: [id])
  product         Product?  @relation(fields: [productId], references: [id])

  @@index([customerId])
  @@index([endDate])
  @@index([status])
  @@map("customer_amc")
}

model Order {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  customerId    String
  leadId        String?
  type          OrderType      @default(PRODUCT)
  status        OrderStatus    @default(PENDING)
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  discountTotal Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal        @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal        @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  invoice       Invoice?
  items         OrderItem[]
  customer      Customer       @relation(fields: [customerId], references: [id])
  lead          Lead?          @relation(fields: [leadId], references: [id])
  payments      Payment[]
  quotations    Quotation[]

  @@index([customerId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  itemName  String
  sku       String?
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  customerId    String?
  orderId       String?
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PAID)
  transactionId String?
  paidAt        DateTime?
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  customer      Customer?     @relation(fields: [customerId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  type      NotificationType
  channel   NotificationChannel @default(ADMIN)
  title     String
  message   String
  payload   Json?
  isRead    Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@map("notifications")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String        @unique
  customerId    String
  status        InvoiceStatus @default(ISSUED)
  amount        Decimal       @db.Decimal(12, 2)
  pdfUrl        String?
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  createdAt     DateTime      @default(now())
  customer      Customer      @relation(fields: [customerId], references: [id])
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  leadId          String?
  customerId      String?
  orderId         String?
  status          QuotationStatus @default(DRAFT)
  amount          Decimal         @db.Decimal(12, 2)
  pdfUrl          String?
  validUntil      DateTime?
  createdAt       DateTime        @default(now())
  customer        Customer?       @relation(fields: [customerId], references: [id])
  lead            Lead?           @relation(fields: [leadId], references: [id])
  order           Order?          @relation(fields: [orderId], references: [id])

  @@index([leadId])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model WebsiteSetting {
  id        String   @id @default(cuid())
  group     String
  key       String   @unique
  value     Json
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("website_settings")
}

model Banner {
  id             String          @id @default(cuid())
  title          String
  placement      BannerPlacement
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  sortOrder      Int             @default(0)
  isEnabled      Boolean         @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement])
  @@index([isEnabled])
  @@map("banners")
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  rating       Int      @default(5)
  message      String
  imageUrl     String?
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished])
  @@map("testimonials")
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@map("faqs")
}

model Blog {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String
  coverImageUrl   String?
  status          BlogStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@map("blogs")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  module    String
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("activity_logs")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LoginResult {
  SUCCESS
  FAILED
  TWO_FACTOR_REQUIRED
}

enum ProductType {
  RO_PURIFIER
  WATER_SOFTENER
  COMMERCIAL_RO_PLANT
  SPARE_PART
  FILTER
  MEMBRANE
  PUMP
  UV_KIT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum LeadSource {
  WEBSITE
  CALL_CENTER
  WHATSAPP
  FACEBOOK
  GOOGLE_ADS
  REFERRAL
  WALK_IN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION_SENT
  WON
  LOST
}

enum ServiceTicketType {
  INSTALLATION
  REPAIR
  MAINTENANCE
  FILTER_REPLACEMENT
  AMC_VISIT
}

enum ServiceTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum AmcPlanTier {
  SILVER
  GOLD
  PLATINUM
}

enum AmcStatus {
  ACTIVE
  RENEWAL_DUE
  EXPIRED
  CANCELLED
}

enum OrderType {
  PRODUCT
  SERVICE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  NEW_LEAD
  NEW_SERVICE_REQUEST
  AMC_EXPIRY
  LOW_STOCK
  PAYMENT_RECEIVED
  SYSTEM
}

enum NotificationChannel {
  ADMIN
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BannerPlacement {
  HERO
  SERVICES
  PRODUCTS
  TESTIMONIALS
  MOBILE
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
